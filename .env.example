# Token de autorización del equipo (todas las rutas del agente lo exigen)
EQUIPO_TOKEN=token-de-tu-equipo

# LLM con visión vía OpenRouter (API compatible OpenAI)
OPENROUTER_API_KEY=sk-or-v1-...
MODELO=anthropic/claude-haiku-5.5

# Escritorio de pruebas (scripts/probar_vnc.py y scripts/runner.py). El agente
# NO lo usa: siempre opera el escritorio que llega en POST /tasks.
# ESCRITORIO_WS va tal cual (wss://.../websockify); la URL https se deriva sola.
ESCRITORIO_WS=ws://127.0.0.1:8765/websockify
ESCRITORIO_PASSWORD=secreto1
ESCRITORIO_TOKEN=token-de-prueba
